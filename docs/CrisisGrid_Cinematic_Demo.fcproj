:"Center","anchor":"Bottom","margin":0.08,"line_spacing":1.25,"outline":4.5,"outline_color":[0,0,0,255],"font_style":"SemiBold"},"enabled":true,"locked":false,"sync_lock":true,"captions":[{"id":61,"start":203212800000,"duration":660441600000,"text":"When natural disasters strike\n<font color=\"#FFE600\"><b>ANYWHERE IN THE WORLD</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":62,"start":889056000000,"duration":838252800000,"text":"emergency operations centers\n<font color=\"#FF2020\"><b>LOSE 45 MINUTES</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":63,"start":1778112000000,"duration":711244800000,"text":"manually cross-referencing\n<font color=\"#FFE600\"><b>AERIAL DRONE FOOTAGE</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":64,"start":2514758400000,"duration":736646400000,"text":"chaotic radio chatter\nand static maps.","speaker":null,"cue_id":null,"settings":""},{"id":65,"start":3302208000000,"duration":711244800000,"text":"Worse, off-the-shelf vision models\n<font color=\"#FF2020\"><b>ROUTINELY HALLUCINATE</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":66,"start":4064256000000,"duration":863654400000,"text":"safe evacuation routes straight through\n<font color=\"#FF2020\"><b>12 FEET OF FLOODWATER</b></font>!","speaker":null,"cue_id":null,"settings":""},{"id":67,"start":5029516800000,"duration":939859200000,"text":"<font color=\"#FFE600\"><b>CRISISGRID</b></font> is an autonomous\nmultimodal triage and dispatch agent,","speaker":null,"cue_id":null,"settings":""},{"id":68,"start":6020179200000,"duration":889056000000,"text":"built on <font color=\"#FFE600\"><b>FIVE META FRONTIER MODELS</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":69,"start":6985440000000,"duration":1193875200000,"text":"Neural models propose;\npure deterministic Python <font color=\"#00FF20\"><b>MATHEMATICS DISPOSES</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":70,"start":8382528000000,"duration":812851200000,"text":"In one click, CrisisGrid launches\n<font color=\"#FFE600\"><b>9x PARALLEL SAM-3.1 CALLS</b></font>,","speaker":null,"cue_id":null,"settings":""},{"id":71,"start":9246182400000,"duration":914457600000,"text":"separating <font color=\"#00FF20\"><b>PASSABLE INFRASTRUCTURE</b></font>\nfrom <font color=\"#FF2020\"><b>CRITICAL HAZARDS</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":72,"start":10211443200000,"duration":1016064000000,"text":"like floodwater, debris, and damaged buildings\n<font color=\"#FFE600\"><b>IN JUST 5 SECONDS</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":73,"start":11303712000000,"duration":889056000000,"text":"Simultaneously, <font color=\"#FFE600\"><b>MUSE-VOICE-TRANSCRIBE-1.0</b></font>\nprocesses responder radio audio,","speaker":null,"cue_id":null,"settings":""},{"id":74,"start":12243571200000,"duration":1016064000000,"text":"decoding the field unit's <font color=\"#FF2020\"><b>MAYDAY CALL</b></font>\ndirectly into structured text","speaker":null,"cue_id":null,"settings":""},{"id":75,"start":13310438400000,"duration":1295481600000,"text":"with <font color=\"#00FF20\"><b>OVER 99% ACCURACY</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":76,"start":15240960000000,"duration":1066867200000,"text":"Next, <font color=\"#FFE600\"><b>MUSE-SPARK-1.3</b></font> fuses the radio call\nwith segmented aerial imagery","speaker":null,"cue_id":null,"settings":""},{"id":77,"start":16358630400000,"duration":1041465600000,"text":"to evaluate <font color=\"#FF2020\"><b>DAMAGE SEVERITY</b></font>\nand propose candidate corridors.","speaker":null,"cue_id":null,"settings":""},{"id":78,"start":17476300800000,"duration":1016064000000,"text":"Spark proposes in <font color=\"#FFE600\"><b>DASHED YELLOW</b></font>,\n<font color=\"#FFE600\"><b>UNVERIFIED BY DESIGN</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":79,"start":18543168000000,"duration":1066867200000,"text":"When its route cuts across floodwater\npast our strict <font color=\"#FF2020\"><b>10% TOLERANCE</b></font>,","speaker":null,"cue_id":null,"settings":""},{"id":80,"start":19686240000000,"duration":1092268800000,"text":"our <font color=\"#FFE600\"><b>LIANG-BARSKY GEOMETRY ENGINE</b></font>\n<font color=\"#FF2020\"><b>INSTANTLY REJECTS IT WITH PROOF</b></font>,","speaker":null,"cue_id":null,"settings":""},{"id":81,"start":20829312000000,"duration":1143072000000,"text":"forcing an autonomous <font color=\"#FFE600\"><b>SELF-CORRECTION LOOP</b></font>\nonto dry elevated asphalt.","speaker":null,"cue_id":null,"settings":""},{"id":82,"start":22048588800000,"duration":1193875200000,"text":"<font color=\"#00FF20\"><b>ZERO PERCENT HAZARD CONTACT</b></font>:\n<font color=\"#00FF20\"><b>CORRIDOR ONE VERIFIED</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":83,"start":23496480000000,"duration":1016064000000,"text":"Only <font color=\"#00FF20\"><b>MATHEMATICALLY VERIFIED</b></font> coordinates\nreach <font color=\"#FFE600\"><b>MUSE-WONDER-1.0</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":84,"start":24588748800000,"duration":939859200000,"text":"for <font color=\"#FFE600\"><b>HIGH-EFFORT TACTICAL DISPATCH</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":85,"start":25604812800000,"duration":1016064000000,"text":"A strict Python guardrail <font color=\"#FF2020\"><b>HOLDS ANY UNIT</b></font>\ntargeted at an unverified zone.","speaker":null,"cue_id":null,"settings":""},{"id":86,"start":26671680000000,"duration":1143072000000,"text":"Wonder synthesizes a <font color=\"#FFE600\"><b>5-UNIT ALLOCATION</b></font>:\n<font color=\"#00FF20\"><b>DRONES · RESCUE BOATS · MEDICAL</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":87,"start":27890956800000,"duration":1117670400000,"text":"Alongside, <font color=\"#FFE600\"><b>MUSE-IMAGE-1.0</b></font> renders an official\n<font color=\"#00FF20\"><b>TACTICAL BRIEFING CARD</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":88,"start":29084832000000,"duration":1143072000000,"text":"generated strictly from <font color=\"#00FF20\"><b>VERIFIED FACTS ONLY</b></font>,","speaker":null,"cue_id":null,"settings":""},{"id":89,"start":30278707200000,"duration":1600300800000,"text":"and one click exports the complete\n<font color=\"#00FF20\"><b>FEMA INCIDENT ACTION PLAN</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":90,"start":32514048000000,"duration":965260800000,"text":"To handle cascading crises,\nCrisisGrid streams <font color=\"#FFE600\"><b>LIVE EARTHQUAKES</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":91,"start":33530112000000,"duration":1016064000000,"text":"directly from the <font color=\"#FFE600\"><b>USGS SEISMIC FEED</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":92,"start":34596979200000,"duration":1092268800000,"text":"Dispatchers select real epicenters to query\n<font color=\"#00FF20\"><b>HOSPITALS & SHELTERS VIA OSM</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":93,"start":35765452800000,"duration":1066867200000,"text":"Finally, our <font color=\"#FFE600\"><b>CLEARANCE DELTA ENGINE</b></font>\nmonitors post-engineering scenes,","speaker":null,"cue_id":null,"settings":""},{"id":94,"start":36883123200000,"duration":1168473600000,"text":"re-scanning <font color=\"#00FF20\"><b>CLEARED BRIDGES</b></font>\nand flipping their status from <font color=\"#FF2020\"><b>BLOCKED</b></font> to <font color=\"#00FF20\"><b>GREEN</b></font>","speaker":null,"cue_id":null,"settings":""},{"id":95,"start":38102400000000,"duration":1143072000000,"text":"ONLY when physical geometry verifies safe passage.","speaker":null,"cue_id":null,"settings":""},{"id":96,"start":39321676800000,"duration":762048000000,"text":"<font color=\"#FFE600\"><b>5 META FRONTIER MODELS</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":97,"start":40134528000000,"duration":558835200000,"text":"<font color=\"#FFE600\"><b>1 API KEY</b></font>.","speaker":null,"cue_id":null,"settings":""},{"id":98,"start":40744166400000,"duration":406425600000,"text":"<font color=\"#00FF20\"><b>ZERO UNVERIFIED GUESSES</b></font>.","speaker":null,"cue_id":null,"settings":""}],"vtt_blocks":[]}]}},"metadata":{},"created":22}},"next_id":99},"view":{"open_sequences":[22],"active_sequence":22,"sequences":{}}}