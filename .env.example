# CrisisGrid - environment template. Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# REQUIRED - single key for the official Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=

# Optional overrides (defaults shown)
META_API_BASE_URL=https://api.meta.ai/v1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (copy the NEXT_PUBLIC_ line into frontend/.env.local if needed)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
